<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/spacing_l"
        app:cardCornerRadius="@dimen/card_corner_radius_huge"
        app:cardBackgroundColor="@color/bg_card"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp"
        app:cardElevation="@dimen/card_elevation_huge">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/icon_size_huge"
                android:layout_height="@dimen/icon_size_huge"
                android:src="@drawable/ic_vpn"
                app:tint="@color/status_warning"
                android:background="@drawable/bg_spinner"
                android:padding="@dimen/spacing_l"
                app:backgroundTint="#20F59E0B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/ttl_dev_vpn_needed"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_size_subhead"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/msg_dev_intranet_fail"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body_large"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/spacing_tiny" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_giant"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelVpn"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/large_button_height"
                    android:layout_weight="1"
                    android:text="@string/btn_all_cancel"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnOpenVpn"
                    style="@style/Widget.DFRtools.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/large_button_height"
                    android:layout_weight="1"
                    android:text="@string/menu_all_vpn"
                    android:textSize="@dimen/text_size_body_small"
                    app:cornerRadius="@dimen/card_corner_radius_medium" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
