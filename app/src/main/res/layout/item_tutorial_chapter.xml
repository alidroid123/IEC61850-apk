<?xml version="1.0" encoding="utf-8"?>
<!-- One chapter of the About screen's step-by-step tutorial (AboutActivity.TUTORIAL). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.DFRtools.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/tutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_l">

            <TextView
                android:id="@+id/tutNumber"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_step_number"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_body_small"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tutTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/customTextPrimaryColor"
                    android:textSize="@dimen/text_size_body_large"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tutGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_small" />
            </LinearLayout>

            <ImageView
                android:id="@+id/tutChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/spacing_s"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tutBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_l"
            android:paddingEnd="@dimen/spacing_l"
            android:paddingBottom="@dimen/spacing_l"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tutSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tutNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:background="@color/bg_navy_dim"
                android:padding="@dimen/spacing_s"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body_small"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tutLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
