<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="@dimen/card_corner_radius_huge"
    app:cardBackgroundColor="?attr/customSurfaceColor"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp"
    app:cardElevation="@dimen/card_elevation_huge">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttl_mon_apply_template"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_m" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="@dimen/spacing_m"
            android:alpha="0.3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lbl_mon_choose_template"
            android:textColor="?attr/customTextPrimaryColor"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_caption"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <Spinner
            android:id="@+id/spinnerRelayTemplate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/standard_button_height"
            android:background="@drawable/bg_spinner_strong"
            android:spinnerMode="dropdown" />

        <RadioGroup
            android:id="@+id/rgTemplateTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbTargetDevice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/lbl_mon_target_pick_device"
                android:textColor="?attr/customTextPrimaryColor"
                android:buttonTint="?attr/colorPrimary" />

            <RadioButton
                android:id="@+id/rbTargetIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/lbl_mon_target_enter_ip"
                android:textColor="?attr/customTextPrimaryColor"
                android:buttonTint="?attr/colorPrimary" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/layoutTargetDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_m">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_mon_target_pick_device_multi"
                android:textColor="?attr/customTextPrimaryColor"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_caption"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_checklist_box">

                <LinearLayout
                    android:id="@+id/containerDeviceChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/spacing_xs" />
            </ScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutTargetIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/spacing_m"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_mon_target_enter_ip"
                android:textColor="?attr/customTextPrimaryColor"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_caption"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <include
                android:id="@+id/layoutIpInputTemplate"
                layout="@layout/layout_ip_input_industrial" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lbl_mon_apply_mode"
            android:textColor="?attr/customTextPrimaryColor"
            android:textStyle="bold"
            android:textSize="@dimen/text_size_caption"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <RadioGroup
            android:id="@+id/rgApplyMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbApplyModeMerge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/lbl_mon_apply_mode_merge"
                android:textColor="?attr/customTextPrimaryColor"
                android:buttonTint="?attr/colorPrimary" />

            <RadioButton
                android:id="@+id/rbApplyModeReplace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_mon_apply_mode_replace"
                android:textColor="?attr/customTextPrimaryColor"
                android:buttonTint="?attr/colorPrimary" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_l"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancelTemplate"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_all_cancel"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnApplyTemplate"
                style="@style/Widget.DFRtools.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:text="@string/btn_mon_apply_template"
                android:paddingHorizontal="@dimen/spacing_l" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
