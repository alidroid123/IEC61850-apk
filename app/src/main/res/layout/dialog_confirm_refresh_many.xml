<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l"
    android:gravity="center"
    android:background="@drawable/bg_spinner"
    android:backgroundTint="@color/bg_card">

    <ImageView
        android:layout_width="@dimen/icon_size_huge"
        android:layout_height="@dimen/icon_size_huge"
        android:src="@drawable/ic_info"
        app:tint="?attr/colorPrimary"
        android:background="@drawable/bg_spinner"
        android:padding="@dimen/spacing_ml"
        app:backgroundTint="#202563EB" />

    <TextView
        android:id="@+id/tvConfirmTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="@string/ttl_mon_refresh_many_confirm"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_title_small"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvConfirmMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_body_large"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/spacing_tiny" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/large_button_height"
            android:layout_weight="1"
            android:text="@string/btn_all_cancel"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body_small"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConfirm"
            style="@style/Widget.DFRtools.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/large_button_height"
            android:layout_weight="1"
            android:text="@string/btn_mon_refresh_confirm"
            android:textSize="@dimen/text_size_body_small"
            app:cornerRadius="@dimen/card_corner_radius_medium" />

    </LinearLayout>

</LinearLayout>
