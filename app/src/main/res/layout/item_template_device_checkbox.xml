<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/spacing_xs"
    android:paddingVertical="@dimen/spacing_xs"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <CheckBox
        android:id="@+id/cbDeviceOption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:buttonTint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_s"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtLine1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/customTextPrimaryColor"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtLine2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="1dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtTypeBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_s"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:textSize="13sp"
        android:maxWidth="96dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="end" />

</LinearLayout>
