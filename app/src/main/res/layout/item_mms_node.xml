<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xs">

    <LinearLayout
        android:id="@+id/nodeRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/spacing_s"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/imgExpand"
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:padding="@dimen/spacing_xs"
            android:src="@drawable/ic_arrow_right"
            app:tint="?attr/colorPrimary" />

        <ImageView
            android:id="@+id/imgIcon"
            android:layout_width="@dimen/icon_size_ms"
            android:layout_height="@dimen/icon_size_ms"
            android:layout_marginStart="@dimen/spacing_xs"
            android:src="@drawable/ic_folder"
            app:tint="?attr/colorSecondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_m"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNodeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body_large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNodeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_small"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_m"
            android:textColor="@color/status_info"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <ImageView
            android:id="@+id/btnAddMonitor"
            android:layout_width="@dimen/icon_size_m"
            android:layout_height="@dimen/icon_size_m"
            android:layout_marginEnd="@dimen/spacing_s"
            android:padding="@dimen/spacing_xs"
            android:src="@drawable/ic_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorSecondary"
            android:visibility="gone" />

    </LinearLayout>

    <View
        android:id="@+id/nodeDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginStart="@dimen/spacing_huge" />

</LinearLayout>
