<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/customBackgroundColor"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_layered">

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-40dp"
            android:background="@drawable/shape_decor_blob_light" />

        <View
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="-30dp"
            android:layout_marginStart="-20dp"
            android:alpha="0.18"
            android:background="@drawable/shape_decor_blob_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingVertical="@dimen/spacing_s">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/icon_size_xl"
                android:layout_height="@dimen/icon_size_xl"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Kembali"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_m"
                android:text="@string/ttl_mms_definitions"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_title_small"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="@dimen/spacing_xs">

                <ImageButton
                    android:id="@+id/btnExportDefinitions"
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:padding="@dimen/spacing_s"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_export"
                    android:contentDescription="@string/btn_mms_definitions_export"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_mms_definitions_export"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_tiny" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/spacing_xs">

                    <TextView
                        android:layout_width="@dimen/def_col_name_width"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_m"
                        android:text="@string/lbl_mms_def_col_name"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_micro"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="@dimen/def_col_address_width"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_m"
                        android:text="@string/lbl_mms_def_col_address"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_micro"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="@dimen/def_col_value_width"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_mms_def_col_value"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_micro"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDefinitions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/spacing_xs" />

            </LinearLayout>

        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/layoutDefinitionsEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xxl"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/icon_size_huge"
                android:layout_height="@dimen/icon_size_huge"
                android:alpha="0.4"
                android:src="@drawable/ic_definition"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:gravity="center"
                android:text="@string/lbl_mms_definitions_empty"
                android:textColor="?attr/customTextPrimaryColor"
                android:textSize="@dimen/text_size_body" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
