<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_l"
    android:gravity="center"
    android:background="@drawable/bg_spinner"
    android:backgroundTint="@color/bg_card">

    <ImageView
        android:layout_width="@dimen/icon_size_huge"
        android:layout_height="@dimen/icon_size_huge"
        android:src="@drawable/ic_download"
        app:tint="@color/status_info"
        android:background="@drawable/bg_spinner"
        android:padding="@dimen/spacing_ml"
        app:backgroundTint="#200284C7" />

    <TextView
        android:id="@+id/tvUpdateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="@string/ttl_all_update_available"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_title_small"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvUpdateMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_size_body_large"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/spacing_tiny" />

    <!-- Hidden entirely when the release has no notes, rather than showing an empty box. -->
    <LinearLayout
        android:id="@+id/layoutUpdateNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_l"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lbl_update_whats_new"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_body_small"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="160dp"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_edit_text"
            android:padding="@dimen/spacing_m">

            <TextView
                android:id="@+id/tvUpdateNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_body_small"
                android:lineSpacingExtra="@dimen/spacing_xs"
                android:gravity="start" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnUpdateLater"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/large_button_height"
            android:layout_weight="1"
            android:text="@string/btn_all_later"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body_small"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnUpdateNow"
            style="@style/Widget.DFRtools.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/large_button_height"
            android:layout_weight="1"
            android:text="@string/btn_all_update"
            android:textSize="@dimen/text_size_body_small"
            app:cornerRadius="@dimen/card_corner_radius_medium" />

    </LinearLayout>

</LinearLayout>
