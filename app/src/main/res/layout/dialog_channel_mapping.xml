<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/card_corner_radius_huge"
    app:cardElevation="@dimen/card_elevation_huge"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider"
    app:cardBackgroundColor="@color/dfr_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttl_view_channel_config"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_title_small"
                android:gravity="center"
                android:layout_marginBottom="@dimen/spacing_l" />

            <!-- TEMPLATE Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_view_template"
                android:textColor="@color/dfr_text_primary"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_caption"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <Spinner
                android:id="@+id/spinner_template"
                android:layout_width="match_parent"
                android:layout_height="@dimen/standard_button_height"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="@dimen/spacing_l" />

            <!-- Dynamic MAPPING Container -->
            <LinearLayout
                android:id="@+id/containerMappingFields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- EXTRA Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_view_show_extra"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_caption"
                android:layout_marginTop="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_s" />

            <LinearLayout
                android:id="@+id/containerExtraChannels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
