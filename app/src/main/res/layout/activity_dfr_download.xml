<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_app">

        <!-- Fixed Header with safe padding -->
        <LinearLayout
            android:id="@+id/headerDfr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_header_industrial"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingVertical="@dimen/spacing_s">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="@dimen/icon_size_xl"
                android:layout_height="@dimen/icon_size_xl"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menu"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_m"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ttl_dl_comtrade_downloader"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_title_small"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/lbl_dl_mms_protocol_sub"
                    android:textColor="#CCFFFFFF"
                    android:textSize="@dimen/text_size_tiny"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageButton
                    android:id="@+id/btnSaveDevice"
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:padding="@dimen/spacing_s"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_save"
                    android:contentDescription="Simpan Device"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_dl_save"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_tiny" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="@dimen/spacing_xs">
                <ImageButton
                    android:id="@+id/btnOpenList"
                    android:layout_width="@dimen/icon_size_xl"
                    android:layout_height="@dimen/icon_size_xl"
                    android:padding="@dimen/spacing_s"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_list"
                    android:contentDescription="Daftar Saved"
                    app:tint="@color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_dl_list"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_tiny" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="@dimen/spacing_xs">
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swIntranetCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/switch_thumb_state"
                    app:trackTint="@color/switch_track_state" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_dl_intranet"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_tiny" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_giant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <!-- Connection card -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.DFRtools.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_m">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/lbl_dl_connection_header"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="@dimen/text_size_body_small"
                                android:textStyle="bold"
                                android:letterSpacing="0.1" />

                            <TextView
                                android:id="@+id/tvPingStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_size_small"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:visibility="visible"
                                tools:text="ONLINE"
                                tools:textColor="@color/status_safe" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_dl_ip_relay"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_caption"
                            android:textStyle="bold"
                            android:layout_marginBottom="@dimen/spacing_xs" />

                        <include
                            android:id="@+id/layoutIpInput"
                            layout="@layout/layout_ip_input_industrial" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPort"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:hint="@string/hint_dl_mms_port"
                            app:boxStrokeColor="@color/divider"
                            app:boxStrokeWidth="1.5dp"
                            app:hintTextColor="?attr/colorPrimary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:singleLine="true"
                                android:text="@string/val_dl_default_port"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/spacing_s"
                                android:text="@string/lbl_dl_profile"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_body_small"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spProfile"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/icon_size_xl"
                                android:background="@drawable/bg_spinner" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="@dimen/spacing_xl">

                            <Button
                                android:id="@+id/btnConnect"
                                style="@style/Widget.DFRtools.Button"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/icon_size_xxl"
                                android:layout_weight="1"
                                android:backgroundTint="@null"
                                android:background="@drawable/bg_button_gradient"
                                android:textSize="@dimen/text_size_body"
                                android:padding="0dp"
                                android:text="@string/btn_dl_connect" />

                            <Button
                                android:id="@+id/btnPing"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/icon_size_xxl"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_s"
                                android:text="@string/btn_dl_ping"
                                android:textSize="@dimen/text_size_body"
                                android:padding="0dp"
                                android:textColor="@color/text_primary"
                                app:strokeWidth="1.5dp"
                                app:strokeColor="@color/divider_bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPingResults"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:background="#000000"
                            android:padding="@dimen/spacing_ms"
                            android:fontFamily="monospace"
                            android:textSize="@dimen/text_size_small"
                            android:textColor="#00FF00"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tvPingResultsPort"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_tiny"
                            android:background="#000000"
                            android:paddingHorizontal="@dimen/spacing_ms"
                            android:paddingBottom="@dimen/spacing_ms"
                            android:fontFamily="monospace"
                            android:textSize="@dimen/text_size_small"
                            android:textColor="#00FF00"
                            android:visibility="gone"
                            tools:visibility="visible"
                            tools:text="PORT 102: OPEN" />

                        <TextView
                            android:id="@+id/tvConnectionStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:text="@string/msg_dl_status_disconnected"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_body_small"
                            android:gravity="center_horizontal" />

                        <TextView
                            android:id="@+id/tvDeviceInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textColor="?attr/colorSecondary"
                            android:textSize="@dimen/text_size_body_small"
                            android:gravity="center_horizontal"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible"
                            tools:text="GI KEMBANGAN • BAY TRAFO 1 • SIEMENS 7SJ" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Vendor info -->
                <TextView
                    android:id="@+id/tvVendorInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:paddingHorizontal="@dimen/spacing_s"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_size_body_small"
                    android:visibility="gone" />

                <!-- Download Mode card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDownloadMode"
                    style="@style/Widget.DFRtools.CardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_l">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_dl_download_mode_header"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_size_body_small"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_s"
                            android:orientation="horizontal">

                            <Spinner
                                android:id="@+id/spDownloadMode"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="@dimen/spacing_s"
                                android:background="@drawable/bg_spinner"
                                android:padding="@dimen/spacing_s" />

                            <Spinner
                                android:id="@+id/spDownloadN"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_spinner"
                                android:padding="@dimen/spacing_s" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnDownloadByMode"
                            style="@style/Widget.DFRtools.Button"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/icon_size_xxl"
                            android:layout_marginTop="@dimen/spacing_l"
                            android:textSize="@dimen/text_size_body"
                            android:text="@string/btn_dl_start_download" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvFileListLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:text="@string/lbl_dl_scan_results_header"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_size_body_small"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/containerFiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_giant"
                    android:gravity="center"
                    android:text="@string/msg_dl_empty_state_ip"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_large"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_xxl"
        android:contentDescription="Panduan Penggunaan"
        android:src="@drawable/ic_info"
        app:backgroundTint="?attr/colorPrimary"
        app:tint="@color/white" />

    <!-- Refactored Drawer Layout: LinearLayout Wrapper for absolute control -->
    <LinearLayout
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/bg_card"
        android:clickable="true"
        android:focusable="true">

        <include layout="@layout/nav_header" />

        <include layout="@layout/drawer_theme_grid" />

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bg_card"
            app:itemIconPadding="@dimen/spacing_l"
            app:itemHorizontalPadding="@dimen/spacing_m"
            app:itemVerticalPadding="@dimen/spacing_ml"
            app:itemIconTint="?attr/colorPrimary"
            app:itemTextColor="@color/text_primary"
            app:itemShapeAppearanceOverlay="@style/ShapeAppearance.App.SmallComponent"
            app:itemShapeFillColor="@color/brand_accent_glow"
            app:menu="@menu/drawer_menu" />

    </LinearLayout>

    <!-- Modern Download Success Overlay -->
    <FrameLayout
        android:id="@+id/overlayProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0E14"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Progress State -->
        <LinearLayout
            android:id="@+id/layoutProgressOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">
            <ProgressBar
                android:layout_width="@dimen/icon_size_xxl"
                android:layout_height="@dimen/icon_size_xxl"
                android:indeterminateTint="?attr/colorPrimary" />
            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:fontFamily="sans-serif-medium"
                tools:text="Mengunduh file..." />
        </LinearLayout>

        <!-- Success Dialog Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutPostDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/spacing_giant"
            app:cardCornerRadius="@dimen/card_corner_radius_giant"
            app:cardElevation="@dimen/card_elevation_large"
            app:strokeWidth="0dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xxl"
                android:background="@color/bg_card">

                <ImageView
                    android:layout_width="@dimen/icon_size_huge"
                    android:layout_height="@dimen/icon_size_huge"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_save"
                    app:tint="@color/status_safe"
                    android:layout_marginBottom="@dimen/spacing_l"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ttl_dl_finished"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_title"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvSuccessSublabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:text="@string/msg_dl_download_success"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_body_large"
                    android:gravity="center"
                    android:lineSpacingExtra="@dimen/spacing_tiny" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="@dimen/spacing_xxl"
                    android:layout_marginBottom="@dimen/spacing_xxl" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false">

                    <Button
                        android:id="@+id/btnOpenDownloaded"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/spacing_xs"
                        android:text="@string/btn_all_open"
                        android:textAllCaps="true"
                        android:textStyle="bold"
                        android:backgroundTint="@color/status_safe"
                        app:cornerRadius="@dimen/spacing_m"
                        app:icon="@drawable/ic_file_open"
                        app:iconGravity="textStart" />

                    <Button
                        android:id="@+id/btnShareDownloaded"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/spacing_xs"
                        android:text="@string/btn_all_share"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorPrimary"
                        app:strokeColor="?attr/colorPrimary"
                        app:cornerRadius="@dimen/spacing_m"
                        app:icon="@drawable/ic_share"
                        app:iconGravity="textStart" />

                    <Button
                        android:id="@+id/btnOpenFolder"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/spacing_xs"
                        android:text="@string/btn_dl_folder"
                        android:textAllCaps="true"
                        android:textColor="@color/text_secondary"
                        app:strokeColor="@color/divider_bold"
                        app:cornerRadius="@dimen/spacing_m"
                        app:icon="@drawable/ic_open_folder"
                        app:iconGravity="textStart" />

                    <Button
                        android:id="@+id/btnCloseOverlay"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/spacing_xs"
                        android:text="@string/btn_all_close"
                        android:textAllCaps="true"
                        android:textColor="@color/status_danger"
                        app:cornerRadius="@dimen/spacing_m" />

                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
