<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="@dimen/card_corner_radius_huge"
    app:cardBackgroundColor="?attr/customSurfaceColor"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp"
    app:cardElevation="@dimen/card_elevation_huge">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_l">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttl_mon_add_to_monitoring"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_body_large"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <TextView
            android:id="@+id/tvAddNodePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_micro"
            android:fontFamily="monospace"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="middle"
            android:layout_marginBottom="@dimen/spacing_m" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="@dimen/spacing_m"
            android:alpha="0.3" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lbl_mon_custom_name">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddCustomName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="?attr/customTextPrimaryColor" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lbl_mon_select_type"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_body_small"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="@dimen/spacing_m" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_xs">

            <TextView
                android:id="@+id/optTypeFloat"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:paddingVertical="@dimen/spacing_s"
                android:gravity="center"
                android:text="@string/lbl_mon_type_float"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/optTypeBool"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:paddingVertical="@dimen/spacing_s"
                android:gravity="center"
                android:text="@string/lbl_mon_type_bool"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/optTypeString"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/spacing_s"
                android:gravity="center"
                android:text="@string/lbl_mon_type_string"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAddUnit"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:hint="@string/lbl_mon_unit">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="?attr/customTextPrimaryColor" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAddMultiplier"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:hint="@string/lbl_mon_multiplier">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddMultiplier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal|numberSigned"
                android:text="1.0"
                android:textColor="?attr/customTextPrimaryColor" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_l"
            android:gravity="end">

            <Button
                android:id="@+id/btnAddCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_all_cancel"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnAddConfirm"
                style="@style/Widget.DFRtools.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:text="@string/btn_all_add"
                android:paddingHorizontal="@dimen/spacing_l" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
