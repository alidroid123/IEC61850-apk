<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/customBackgroundColor">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_layered">

        <View
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-40dp"
            android:background="@drawable/shape_decor_blob_light" />

        <View
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="-30dp"
            android:layout_marginStart="-20dp"
            android:alpha="0.18"
            android:background="@drawable/shape_decor_blob_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/spacing_giant"
            android:paddingBottom="@dimen/spacing_xxl"
            android:paddingHorizontal="@dimen/spacing_l">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/icon_size_xl"
                android:layout_height="@dimen/icon_size_xl"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:text="@string/ttl_help_main"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_title"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DFRtools.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimary"
                android:layout_marginBottom="@dimen/spacing_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_help_intro_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_body_large"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_s" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/msg_help_intro_body"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_body"
                        android:lineSpacingExtra="@dimen/spacing_xs"
                        android:alpha="0.92" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_edit_text_strong"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_l">

                <ImageView
                    android:layout_width="@dimen/icon_size_s"
                    android:layout_height="@dimen/icon_size_s"
                    android:src="@drawable/ic_search"
                    app:tint="?attr/colorSecondary" />

                <EditText
                    android:id="@+id/etSearchHelp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_help_search"
                    android:textColor="?attr/customTextPrimaryColor"
                    android:textSize="@dimen/text_size_body"
                    android:inputType="text"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/spacing_s" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvHelpNoResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_l"
                android:text="@string/msg_help_no_results"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_size_body"
                android:gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/containerHelpSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
