    <string name="lbl_help_intro_title">Selamat Datang di DFRtools</string>
    <string name="msg_help_intro_body">Panduan ini menjelaskan setiap layar pada aplikasi dan cara penggunaannya. Ketuk salah satu bagian di bawah untuk membuka penjelasannya.</string>
    <string name="hint_help_search">Cari topik bantuan… (mis. \"alarm\", \"template\", \"backup\")</string>
    <string name="msg_help_no_results">Tidak ada topik bantuan yang cocok</string>
