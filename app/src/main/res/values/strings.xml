    <!-- // Help -->
    <string name="lbl_help_intro_title">Welcome to DFRtools</string>
    <string name="msg_help_intro_body">This guide explains every screen in the app and how to use it. Tap a section below to expand its explanation.</string>
    <string name="hint_help_search">Search help topics… (e.g. \"alarm\", \"template\", \"backup\")</string>
    <string name="msg_help_no_results">No help topics match your search</string>
    <string name="lbl_help_function">Function:</string>
    <string name="lbl_help_howto">How to use:</string>

    <string name="help_ttl_home">Home</string>
    <string name="help_sum_home">Main menu and shortcuts to every feature</string>
    <string name="help_func_home">The main dashboard shown right after the splash screen. It gives quick-access cards to the app\'s core features and a side menu for settings and other tools.</string>
    <string name="help_steps_home">1. Tap a menu card (Download DFR, File History, DFR Viewer, Relay List, IED Explorer, IED Monitoring) to open that feature.\n2. The summary banner below the menu (Substations, Online, Active Alarms) gives an instant fleet-wide overview - open Relay List or IED Monitoring for the full detail behind these numbers.\n3. Tap the menu icon in the top-left corner to open the side drawer.\n4. From the drawer you can switch Light/Dark mode, open Settings, open IED Monitoring, open Edit Template, connect to VPN, or view About.</string>

    <string name="help_ttl_download">Comtrade Downloader</string>
    <string name="help_sum_download">Download COMTRADE (DFR) files from a relay over MMS</string>
    <string name="help_func_download">Connects to a protection relay via the IEC 61850 MMS protocol to search for and download COMTRADE (DFR) fault-recording files.</string>
    <string name="help_steps_download">1. Enter the relay\'s IP address, or tap the list icon to pick a saved device.\n2. Choose a Profile if needed (Default / ABB-GE / Schneider), then tap CONNECT.\n3. Pick a download mode: Bulk (latest files), Single (N-th file), or Deep Scan (search multiple folders).\n4. Tap DOWNLOAD next to a file in the scan results.\n5. Downloaded files are saved automatically and can be reopened from Download History.</string>

    <string name="help_ttl_history">Download History</string>
    <string name="help_sum_history">Browse, open, and manage downloaded DFR files</string>
    <string name="help_func_history">Local file manager for every COMTRADE file that has been downloaded, organized by folder so past records are easy to find again.</string>
    <string name="help_steps_history">1. Browse folders/files in the list; tap a .cfg file to open it in DFR Viewer.\n2. Use the menu on a file or folder to delete or share it.\n3. On Android 11+, grant the \'Manage All Files\' permission if asked, so downloaded files can be shown here.</string>

    <string name="help_ttl_devices">Relay / Device List</string>
    <string name="help_sum_devices">Manage the relay database: add, ping, import/export CSV</string>
    <string name="help_func_devices">A database of protection relays (substation, bay, device name, IP, brand, and type) so devices don\'t need to be re-entered every time. Includes online/offline ping status.</string>
    <string name="help_steps_devices">1. Add a device manually, or Import a CSV file (use Export Template first to see the required column order).\n2. Tap PING on a device to check if it\'s reachable, or use Bulk Ping to check every device at once.\n3. Tap a device card to choose an action: Download DFR, IED Explorer, Ping, or Delete.\n4. Use Export to save the current device list as a CSV backup.</string>

    <string name="help_ttl_explorer">IED Explorer</string>
    <string name="help_sum_explorer">Browse an IED\'s IEC 61850 data model live</string>
    <string name="help_func_explorer">Connects live to an IED and lets you browse its full IEC 61850 data model tree (Logical Device, Logical Node, Data Object, Data Attribute), reading real-time values along the way.</string>
    <string name="help_steps_explorer">1. Enter the IP address (or pick from the Relay List), then tap EXPLORE to connect.\n2. Tap a folder row to expand/collapse that branch of the tree.\n3. Use the search bar to filter the tree by name or path.\n4. Tap the + icon next to a value to add that point to IED Monitoring (choose Float/Integer or Boolean).\n5. Tap the refresh icon to rebuild the structure from scratch if it looks outdated.\n6. Tap CLOSE IED to disconnect when finished.</string>

    <string name="help_ttl_viewer">DFR Viewer</string>
    <string name="help_sum_viewer">View and analyze COMTRADE waveform recordings</string>
    <string name="help_func_viewer">Opens a COMTRADE (.cfg + .dat) file pair and plots its analog and digital channels for fault analysis, with cursors, zoom, and report export.</string>
    <string name="help_steps_viewer">1. Open a file from Download History, or choose one manually.\n2. Use the channel configuration menu to rename, group, or show/hide channels.\n3. Drag the T1/T2 cursors on the chart to measure the time and value difference between two points.\n4. Pinch to zoom, or use the menu to reset the zoom level.\n5. Use DOWNLOAD IMG or EXPORT TO PDF to save the chart/report for a case file.</string>

    <string name="help_ttl_monitoring">IED Monitoring</string>
    <string name="help_sum_monitoring">Live values and alarms from multiple IEDs at once</string>
    <string name="help_func_monitoring">Continuously polls a saved list of monitored points across one or more IEDs, grouped by device, with configurable alarm thresholds and a live status indicator per device.</string>
    <string name="help_steps_monitoring">1. Add points from IED Explorer using its + icon, or bulk-add a whole relay type\'s points at once with the \"Template\" icon in the header (see the Edit Template section below).\n2. Each device group header shows a connection dot and the full last-update date/time (e.g. \"Kamis, 27 Agustus 2026 18:00:09 WIB\").\n3. For boolean points, TRUE is shown in red and FALSE in green - this matches a fault/alarm condition usually being TRUE.\n4. Tap the pencil icon on a point to rename it, set its unit/multiplier, invert a boolean, or enable an Alarm with a high/low threshold (or an alarm boolean state).\n5. When a point breaches its alarm, its value/accent turns red for an at-a-glance warning.\n6. Tap the refresh icon or pull down the list to force an immediate update.\n7. Use the search bar to quickly find a point when the list is long.</string>

    <string name="help_ttl_template">Edit Template</string>
    <string name="help_sum_template">Define reusable monitoring point sets per relay type/model</string>
    <string name="help_func_template">Lets you author and maintain relay templates - a named set of monitoring points (name, IEC 61850 address suffix, type, unit, multiplier) tied to a relay model rather than one physical device. Once defined, a template can be applied to any device of that model from IED Monitoring\'s \"Template\" button, instead of adding every point by hand via IED Explorer.</string>
    <string name="help_steps_template">1. Open it from the side drawer (\"Edit Template\").\n2. Use the spinner at the top to pick which template to edit; the trash icon next to it deletes the whole template (with confirmation).\n3. Tap \"+ Add Template\" in the header to create a new, empty template, or the copy icon next to it to duplicate the currently selected one under a new name.\n4. In the table, fill in each row\'s Name, Address (the LD/LN.DO.DA suffix - no device name prefix), Type (string/float/boolean), Unit, and Multiplier. Use \"Add Row\" below the table for a new point, and the trash icon at the end of a row to remove it (with confirmation).\n5. Field edits, added rows, and deleted rows only take effect after tapping \"Save\" - switching templates or leaving without saving discards them.\n6. Go to IED Monitoring → \"Template\" button to apply a saved template to one or more devices of that relay model.</string>

    <string name="help_ttl_settings">App Settings</string>
    <string name="help_sum_settings">MMS port, ping, monitoring interval, language, backup, and more</string>
    <string name="help_func_settings">Configures technical defaults used throughout the app: MMS connection settings, ping behavior, DFR viewer defaults, monitoring update interval, cache, app language, and backing up/restoring the app\'s configuration.</string>
    <string name="help_steps_settings">1. Adjust a field, then save that section.\n2. Use \'Clear Application Cache\' if downloaded structure caches take up too much storage.\n3. Change \'Application Language\' to switch the whole app between Indonesian and English instantly.\n4. Under \'Backup &amp; Restore\', tap \'Export Configuration\' to save the device list, monitoring points, and relay templates into one JSON file (you can then share it or keep it as a backup).\n5. Tap \'Import Configuration\' and pick a previously exported file to merge its devices/points/templates into what\'s already on this phone - existing entries are never overwritten or deleted, only new ones are added.</string>

    <string name="help_ttl_about">About Application</string>
    <string name="help_sum_about">App version, developer, and description</string>
    <string name="help_func_about">Shows the app\'s purpose, current version number, and developer credit.</string>
    <string name="help_steps_about">Open it from the side drawer to check which app version you\'re running, for example when reporting an issue.</string>

    <string name="help_ttl_tips">Additional Tips</string>
    <string name="help_sum_tips">Intranet/VPN, themes, and general notes</string>
    <string name="help_func_tips">General notes that apply across the app: how the Intranet/VPN check works, how to switch color themes, and which actions require a network connection to the relay.</string>
    <string name="help_steps_tips">1. Toggle the INTRANET switch on a connection screen for a quick reachability check before connecting; if it fails, the app offers to open the FortiClient VPN app (also reachable directly from the side drawer).\n2. Open the side drawer and tap the sun/moon icon to switch between several color themes and Light/Dark mode.\n3. Most of the app works fully offline; only actions that talk to a physical relay (connect, explore, download, monitor, ping) need the phone on the same network as the relay, usually via VPN.</string>
</resources>
