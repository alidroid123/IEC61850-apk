<?xml version="1.0" encoding="utf-8"?>
<!--
    Outline pill for the app-version footer. Replaces the earlier full-width solid banner, which
    read as a heavy horizontal slab at the bottom of Home; an outlined pill sized to its own text
    carries the same information without competing with the menu cards above it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="100dp" />
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="?attr/colorPrimary" />
</shape>
