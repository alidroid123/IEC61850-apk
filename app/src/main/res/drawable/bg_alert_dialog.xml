<?xml version="1.0" encoding="utf-8"?>
<!-- Window background of standard AlertDialogs (Theme.Comtrade.AlertDialog): an opaque rounded
     card in the card colour (light/dark aware via @color/bg_card), outlined in the theme colour. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp"
    android:insetTop="16dp"
    android:insetRight="16dp"
    android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <corners android:radius="20dp" />
        <solid android:color="@color/bg_card" />
        <stroke
            android:width="1dp"
            android:color="?attr/colorPrimary" />
    </shape>
</inset>
