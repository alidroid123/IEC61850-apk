<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode. -->
    <style name="Theme.DFRtools" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowBackground">?attr/customBackgroundColor</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <item name="alertDialogTheme">@style/Theme.Comtrade.Dialog</item>
    </style>

    <!-- Dark Variants of the 4 Themes -->
    <style name="Theme.DFRtools.Blue" parent="Theme.DFRtools">
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorSecondary">#1D4ED8</item>
        <item name="customBackgroundColor">#0F172A</item>
        <item name="customSurfaceColor">#1E293B</item>
        <item name="customTextPrimaryColor">#F8FAFC</item>
        <item name="customAccentColor">#F59E0B</item>
    </style>

    <style name="Theme.DFRtools.Emerald" parent="Theme.DFRtools">
        <item name="colorPrimary">#10B981</item>
        <item name="colorSecondary">#047857</item>
        <item name="customBackgroundColor">#111827</item>
        <item name="customSurfaceColor">#1F2937</item>
        <item name="customTextPrimaryColor">#F9FAFB</item>
        <item name="customAccentColor">#F97316</item>
    </style>

    <style name="Theme.DFRtools.Purple" parent="Theme.DFRtools">
        <item name="colorPrimary">#8B5CF6</item>
        <item name="colorSecondary">#6D28D9</item>
        <item name="customBackgroundColor">#18181B</item>
        <item name="customSurfaceColor">#27272A</item>
        <item name="customTextPrimaryColor">#FAFAFA</item>
        <item name="customAccentColor">#22C55E</item>
    </style>

    <style name="Theme.DFRtools.Red" parent="Theme.DFRtools">
        <item name="colorPrimary">#EF4444</item>
        <item name="colorSecondary">#B91C1C</item>
        <item name="customBackgroundColor">#111827</item>
        <item name="customSurfaceColor">#1F2937</item>
        <item name="customTextPrimaryColor">#F9FAFB</item>
        <item name="customAccentColor">#0EA5E9</item>
    </style>

    <!--
        Theme 5 - ABSTRACT (dark). Same six-slot rotation as the light variants in
        values/themes.xml - see the long comment there for the two palette rules (short
        gradient hops that never cross the yellow/olive band; high-contrast accent used flat
        only). Slot-by-slot role assignment is identical; only the hues and neutrals differ.

        Palette: 0 Azure #0EA5E9 | 1 Violet #8B5CF6 | 2 Magenta #EC4899
                 3 Coral #F97316 | 4 Teal   #14B8A6 | 5 Green   #22C55E
        Neutrals are a slightly warm near-black rather than the slate/zinc the other dark themes
        use, so Abstract keeps its own identity in dark mode too.
    -->
    <style name="Theme.DFRtools.Abstract.S0" parent="Theme.DFRtools">
        <item name="colorPrimary">#0EA5E9</item>       <!-- Azure -->
        <item name="colorSecondary">#8B5CF6</item>     <!-- Violet -->
        <item name="customAccentColor">#EC4899</item>  <!-- Magenta -->
        <item name="customBackgroundColor">#131318</item>
        <item name="customSurfaceColor">#1E1E26</item>
        <item name="customTextPrimaryColor">#FAFAFA</item>
    </style>

    <style name="Theme.DFRtools.Abstract.S1" parent="Theme.DFRtools">
        <item name="colorPrimary">#8B5CF6</item>       <!-- Violet -->
        <item name="colorSecondary">#EC4899</item>     <!-- Magenta -->
        <item name="customAccentColor">#F97316</item>  <!-- Coral -->
        <item name="customBackgroundColor">#131318</item>
        <item name="customSurfaceColor">#1E1E26</item>
        <item name="customTextPrimaryColor">#FAFAFA</item>
    </style>

    <style name="Theme.DFRtools.Abstract.S2" parent="Theme.DFRtools">
        <item name="colorPrimary">#EC4899</item>       <!-- Magenta -->
        <item name="colorSecondary">#F97316</item>     <!-- Coral -->
        <item name="customAccentColor">#14B8A6</item>  <!-- Teal -->
        <item name="customBackgroundColor">#131318</item>
        <item name="customSurfaceColor">#1E1E26</item>
        <item name="customTextPrimaryColor">#FAFAFA</item>
    </style>

    <style name="Theme.DFRtools.Abstract.S3" parent="Theme.DFRtools">
        <item name="colorPrimary">#F97316</item>       <!-- Coral -->
        <item name="colorSecondary">#EC4899</item>     <!-- Magenta (steps back, see note 1) -->
        <item name="customAccentColor">#0EA5E9</item>  <!-- Azure -->
        <item name="customBackgroundColor">#131318</item>
        <item name="customSurfaceColor">#1E1E26</item>
        <item name="customTextPrimaryColor">#FAFAFA</item>
    </style>

    <style name="Theme.DFRtools.Abstract.S4" parent="Theme.DFRtools">
        <item name="colorPrimary">#14B8A6</item>       <!-- Teal -->
        <item name="colorSecondary">#0EA5E9</item>     <!-- Azure -->
        <item name="customAccentColor">#EC4899</item>  <!-- Magenta -->
        <item name="customBackgroundColor">#131318</item>
        <item name="customSurfaceColor">#1E1E26</item>
        <item name="customTextPrimaryColor">#FAFAFA</item>
    </style>

    <style name="Theme.DFRtools.Abstract.S5" parent="Theme.DFRtools">
        <item name="colorPrimary">#22C55E</item>       <!-- Green -->
        <item name="colorSecondary">#0EA5E9</item>     <!-- Azure -->
        <item name="customAccentColor">#8B5CF6</item>  <!-- Violet -->
        <item name="customBackgroundColor">#131318</item>
        <item name="customSurfaceColor">#1E1E26</item>
        <item name="customTextPrimaryColor">#FAFAFA</item>
    </style>
</resources>
