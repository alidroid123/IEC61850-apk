<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="com.fortinet.forticlient_vpn" />
    </queries>

    <application
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DFRtools">

        <activity
            android:name=".dfr.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Comtrade.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".dfr.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".dfr.DfrDownloadActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".dfr.InternalFileManagerActivity"
            android:exported="false"
            android:label="History Download" />

        <activity
            android:name=".dfr.DeviceListActivity"
            android:exported="false"
            android:label="Daftar Device" />

        <activity
            android:name=".dfr.AboutActivity"
            android:exported="false"
            android:label="Tentang Aplikasi" />

        <activity
            android:name=".dfr.MmsExplorerActivity"
            android:exported="false"
            android:label="MMS Explorer (Advanced)" />

        <activity
            android:name=".dfr.DfrViewerActivity"
            android:exported="true"
            android:label="DFR Viewer"
            android:theme="@style/Theme.DFRtools.Viewer">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.cfg" />
                <data android:pathPattern=".*\\.CFG" />
                <data android:pathPattern=".*\\.dat" />
                <data android:pathPattern=".*\\.DAT" />
                <data android:pathPattern=".*\\.hdr" />
                <data android:pathPattern=".*\\.HDR" />
                <data android:pathPattern=".*\\.inf" />
                <data android:pathPattern=".*\\.INF" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".dfr.IEDMonitoringActivity"
            android:exported="false"
            android:label="IED Monitoring" />

        <service
            android:name=".dfr.MonitoringRefreshService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".update.AppFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <service
            android:name=".update.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".dfr.SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <activity
            android:name=".dfr.RelayTemplateEditActivity"
            android:exported="false"
            android:label="Edit Relay Template" />

        <activity
            android:name=".dfr.HelpActivity"
            android:exported="false"
            android:label="Help" />

    </application>

</manifest>
